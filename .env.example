PORT=3100
# Leave empty for local SQLite. Docker Compose sets PostgreSQL automatically.
DATABASE_URL=
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_ORIGIN=http://localhost:3100
# Optional: Set admin email to automatically grant admin rights to this account
ADMIN_EMAIL=
COOKIE_SECURE=false
# Set true behind an HTTPS reverse proxy, and TRUST_PROXY=1 for one trusted proxy.
TRUST_PROXY=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
